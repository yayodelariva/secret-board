<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
            <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
<link rel="stylesheet" type="text/css" href="/styles/styles.css">
    <title>Dashboard</title>
  </head>
  <body>
    <%- include("partials/navbar") %>
    <h1 class="display-4">Welcome, <%= user.username %>!</h1>

    <section class="form-section">
      <div>
        <form class="" action="/posts" method="POST">
          <div class="post-form">
            <label for="post-content">Create a post:</label>
            <textarea
              style="resize: none"
              id="post-content"
              name="message"
              rows="4"
              cols="50"
            ></textarea>
          </div>
          <button class="btn btn-light" type="submit">Post</button>
        </form>
      </div>
    </section>
    <div class="membership-section">
<% if (user.membership_status) { %>
  <p>You are a member. You can now see usernames and dates!</p>
<% } else { %>
  <form action="/membership" method="POST">
    <label for="membership-code">Become a member</label>

    <input
      type="text"
      placeholder="find the 4 digit code somewhere in the site"
      id="membership-code"
      name="membership-code"
      maxlength="4"
      required
    />

    <button class="btn btn-light" type="submit">Redeem</button>
  </form>
<% } %>
    </div>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
