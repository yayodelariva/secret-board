<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="stylesheet" type="text/css" href="/styles/styles.css">
    <title>Homepage</title>
  </head>
  <body>
    <h1>Secret Board</h1>
<nav class="navbar">
  <% if (isAuthenticated) { %>
    <a href="/dashboard">Dashboard</a>

    <form action="/logout" method="POST">
      <button type="submit">Log Out</button>
    </form>
  <% } else { %>
    <a href="/signup">Sign Up</a>
    <a href="/login">Log In</a>
  <% } %>
</nav>
    <div class="message-board">
      <h2>Latest Posts</h2>

<% posts.forEach(post => { %>
  <article>
    <p><%= post.message %></p>

<% if (isAuthenticated) { %>
  <small>
    Posted by <%= post.username %>
    on <%= post.created_at.toLocaleString() %>
  </small>
<% } else { %>
  <small class="hidden-info">
    Posted by: <div class="hidden-user">&nbsp;hidden&nbsp;</div>
    on <div class="hidden-date">&nbsp;6/66/666, 6:66:66 PM </div>
  </small>
<% } %>
  </article>
<% }) %>
    </div>
  </body>
</html>
