<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
<link rel="stylesheet" type="text/css" href="/styles/styles.css">
    <title>Homepage</title>
  </head>
  <body>
        <%- include("partials/navbar") %>


<div class="message-board-container">
  <div class="message-board">
    <h2>Latest Posts</h2>
  
    <% posts.forEach(post => { %>
      <article>
        <p><%= post.message %></p>
  
        <% if (isAuthenticated && isMember) { %>
          <small>
            Posted by <%= post.username %>
            on <%= post.created_at.toLocaleString() %>
          </small>
        <% } else { %>
          <small class="hidden-info">
            Posted by:
            <div class="hidden-user">&nbsp;hidden&nbsp;</div>
            on
            <div class="hidden-date">&nbsp;6/66/666, 6:66:66 PM</div>
          </small>
        <% } %>
  
        <% if (isAdmin) { %>
          <form action="/posts/<%= post.id %>/delete" method="POST">
            <button class="btn btn-danger" type="submit"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
  <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
  <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
</svg></i></button>
          </form>
        <% } %>
      </article>
    <% }) %>
  </div>
</div>


    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
